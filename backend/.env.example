# ===== HyPRA 后端环境变量模板 =====
# 复制为 backend/.env 后填入真实值；.env 已被 gitignore，严禁入库。

# ---- 基础 ----
DEBUG=false

# ---- 外部服务（云端 key 一律只放 .env）----
# Qdrant Cloud（温层向量库）
# QDRANT_URL=
# QDRANT_API_KEY=

# 模型托管 API（阿里百炼 / 硅基流动）
# DASHSCOPE_API_KEY=
# SILICONFLOW_API_KEY=

# 魔珐星云（数字人 + TTS）
# MOYA_APP_ID=
# MOYA_ACCESS_TOKEN=
