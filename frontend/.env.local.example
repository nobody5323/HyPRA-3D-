# ===== HyPRA 前端环境变量模板 =====
# 复制为 frontend/.env.local 后按需修改（.env.local 已被 gitignore，不入库）

# 后端 API 地址
# - 本地开发：http://localhost:8000
# - docker compose：http://localhost:8000（宿主机访问）或 http://backend:8000（容器内）
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ---- 魔珐具身驱动 SDK（数字人渲染 + 语音）----
# 从魔珐控制台「密钥管理」获取（**驱动应用**的 App ID / App Secret）。
# 留空或初始化失败时，前端会自动降级为「浏览器原生 TTS + 占位形象」，演示不中断。
#
# 安全提示：前端密钥按官方 SDK 设计需在浏览器使用；正式上线建议由后端签发临时凭证。
NEXT_PUBLIC_XMOV_APP_ID=
NEXT_PUBLIC_XMOV_APP_SECRET=
